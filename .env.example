# Copy this file's variable names into your hosting platform's Environment
# Variables settings (Vercel dashboard → Project → Settings → Environment
# Variables). Never commit a real .env file with real keys to git.

# AI chat: single key covers all 5 models in the picker (openrouter.ai —
# free signup, no card). This REPLACES the old separate GROQ_API_KEY and
# GEMINI_API_KEY — remove those from Vercel if they're still set.
OPENROUTER_API_KEY=your_openrouter_key_here

FINNHUB_API_KEY=your_finnhub_key_here
NEWSDATA_API_KEY=your_newsdata_key_here
